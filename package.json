{
  "name": "staff-scheduler",
  "version": "1.0.0",
  "description": "Staff Availability & Scheduling System",
  "author": "Staff Scheduler Team",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "electron": "electron .",
    "build": "npm run build --prefix client",
    "build-win": "electron-builder"
  },
  "main": "main.js",
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.staff.scheduler",
    "productName": "Staff Scheduler",
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}